# Copy to .env and fill in your values. .env is gitignored.

# Google Drive handler: API key for the Drive API v3.
# Create one at https://console.cloud.google.com/ with the Drive API enabled.
GOOGLE_API_KEY=

# Filester handler: API key sent as "Authorization: Bearer <key>".
# Get one from Account Settings at https://filester.me/ (see https://filester.me/api-docs).
# Optional -- public folders and files download fine without it.
FILESTER_API_KEY=

# Gofile handler: account API token sent as "Authorization: Bearer <token>".
# Get one from My Profile at https://gofile.io/ (see https://gofile.io/api).
# Optional -- without it a throwaway guest account is created per run. Gofile
# gates listings behind Premium, which the handler works around with the same
# X-Website-Token the website sends; set a Premium token here if that stops working.
GOFILE_API_TOKEN=

